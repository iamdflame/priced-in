{
  "name": "pricedin-video",
  "private": true,
  "version": "0.1.0",
  "description": "Priced In demo film: the Remotion motion system (Pulse brand).",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-footage.mjs",
    "studio": "remotion studio src/index.ts",
    "render:test": "remotion render src/index.ts TestReel ../.apex/design/video/renders/test-reel.mp4 --codec h264 --crf 16",
    "render:test-vertical": "remotion render src/index.ts TestReelVertical ../.apex/design/video/renders/test-reel-vertical.mp4 --codec h264 --crf 16",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.541",
    "remotion": "4.0.541",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@remotion/bundler": "4.0.541",
    "@remotion/renderer": "4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
