{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund",
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{services/ai/attestations/**,services/ai/src/**,tools/judge/evidence/rewrite.json,tools/judge/evidence/attestations/**,api/_data/**}"
    },
    "api/after-trade.mjs": {
      "maxDuration": 180,
      "memory": 1024,
      "includeFiles": "{services/ai/attestations/**,services/ai/src/**,tools/judge/evidence/rewrite.json,api/_data/**}"
    },
    "api/after-challenge.mjs": {
      "maxDuration": 240,
      "memory": 1024,
      "includeFiles": "{services/ai/attestations/**,services/ai/src/**,tools/judge/evidence/rewrite.json,api/_data/**,node_modules/unpdf/dist/**}"
    },
    "api/cron.mjs": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{services/ai/attestations/**,services/ai/src/**,tools/judge/evidence/rewrite.json,api/_data/**,node_modules/unpdf/dist/**}"
    },
    "api/sentinel.mjs": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "{services/ai/src/**,api/_data/**,node_modules/unpdf/dist/**}"
    },
    "api/news.mjs": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "{services/ai/attestations/**,services/ai/src/**,tools/judge/evidence/rewrite.json,api/_data/**,node_modules/unpdf/dist/**}"
    }
  },
  "crons": [
    { "path": "/api/cron", "schedule": "*/10 * * * *" },
    { "path": "/api/health", "schedule": "* * * * *" },
    { "path": "/api/sentinel", "schedule": "* * * * *" },
    { "path": "/api/news", "schedule": "5 * * * *" }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__p=/:path*" },
    { "source": "/health", "destination": "/api/index?__p=/health" },
    { "source": "/claims", "destination": "/api/index?__p=/claims" },
    { "source": "/claims/:path*", "destination": "/api/index?__p=/claims/:path*" },
    { "source": "/events", "destination": "/api/index?__p=/events" },
    { "source": "/events/:path*", "destination": "/api/index?__p=/events/:path*" },
    { "source": "/v1", "destination": "/api/index?__p=/v1" },
    { "source": "/v1/:path*", "destination": "/api/index?__p=/v1/:path*" },
    { "source": "/x402/:path*", "destination": "/api/index?__p=/x402/:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "x-content-type-options", "value": "nosniff" },
      { "key": "referrer-policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
