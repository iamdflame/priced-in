# Priced In web: copy to web/.env.local and edit. Only VITE_* values reach the browser,
# and none of them is a secret: the lane key is made in the visitor's browser.

# services/api (services/ai mounts its routes on the same server)
VITE_API_BASE=http://127.0.0.1:8787

# testnet unless set to mainnet explicitly; a testnet build refuses mainnet accounts and RPCs
VITE_NEAR_NETWORK=testnet

# RPCs to race when the lane key answer names none (comma-separated)
# VITE_RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org

# the doubt button's stake in micro-USDC, and the liquidity assumed when a claim view gives none
# VITE_DOUBT_MICRO=1000000
# VITE_DEFAULT_B_MICRO=1000000

# timings: how long "preparing your $1" may last, and when a send counts as an RPC stall
# VITE_LANE_READY_TIMEOUT_MS=15000
# VITE_STALL_MS=12000
