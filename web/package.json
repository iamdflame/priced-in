{
  "name": "pricedin-web",
  "private": true,
  "type": "module",
  "description": "Priced In web: the engine (src/core) and the site (src/ui, the clarity design).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/bundle-size.mjs",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "vectors": "node scripts/lmsr-vectors.mjs",
    "fixture": "node scripts/make-fixture.mjs",
    "ui-data": "node scripts/make-ui-data.mjs",
    "serve:offline": "node e2e/serve.mjs",
    "shots": "node e2e/shoot-clarity.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
