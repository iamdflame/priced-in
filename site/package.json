{
  "name": "pricedin-site",
  "private": true,
  "description": "Priced In: the product site in the Pulse brand. Next.js App Router, server-rendered from the live API.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "catalog": "node scripts/build-catalog.mjs",
    "pages": "node scripts/build-pages.mjs",
    "e2e:money": "playwright test -c playwright.money.config.ts"
  },
  "dependencies": {
    "@near-js/transactions": "^2.5.1",
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/hot-wallet": "^10.1.4",
    "@near-wallet-selector/intear-wallet": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "@near-wallet-selector/my-near-wallet": "^10.1.4",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "near-api-js": "^7.4.0",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
