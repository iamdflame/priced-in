# Priced In site. Nothing here is a secret: the free-bet key is made in the visitor's browser.
# The API origin the site forwards /api, /claims, /health, /events, /lane, /v1 and /post to.
API_ORIGIN=https://isitpriced.com
# mainnet (default) or testnet; a build refuses accounts and RPCs from the other network
NEAR_NETWORK=mainnet
# the public URL, for share cards and canonical links
SITE_URL=https://isitpriced.com
