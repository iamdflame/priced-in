# Priced In site. One value here is a secret, PROXY_SECRET; the free-bet key is made in the visitor's browser.
# The API origin the site forwards /api, /claims, /health, /events, /lane, /v1 and /post to.
API_ORIGIN=https://isitpriced.com
# mainnet (default) or testnet; a build refuses accounts and RPCs from the other network
NEAR_NETWORK=mainnet
# the public URL, for share cards and canonical links
SITE_URL=https://isitpriced.com
# Secret, shared with the API (the same PROXY_SECRET there). With it, forwarded requests carry the visitor's
# address, so the API's per-address limits stay per visitor. Unset, the API sees only this site's edge.
PROXY_SECRET=
