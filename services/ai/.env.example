# Priced In AI layer. Copy to services/ai/.env (git-ignored). `npm run ai` reads services/api/.env
# first (network, RPCs, market), then this file. Testnet unless NEAR_NETWORK=mainnet.

# SECRET. Without it: template rewrites marked unsigned, no agents, no jury. Attestations still work.
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1

# Writer: a NEAR-fleet model, non-streamed, for provider_tee signatures.
WRITER_MODEL=z-ai/glm-5.3-flash
WRITER_SIGNATURE_DEADLINE_MS=6000
# Optional curated pages: {"pages":{"slug":{"paragraphs":[[0,1],[2]],"sources":["https://..."]}}}
# PAGES_FILE=

# House agents: name=model,... Their keys are NOT set here. SIGNER_KEYS_FILE is a path that only
# the signer process opens. Format: {"agents":{"house-ledger":{"accountId":"...","privateKey":"ed25519:..."}}}
# Each key must be a function-call key on the market limited to buy and sell, or it is refused.
# Any AGENT_*KEY, HOUSE_*KEY or SIGNER_*KEY variable makes startup fail on purpose.
HOUSE_AGENTS=house-ledger=z-ai/glm-5.3-flash,house-archive=Qwen/Qwen3.8-27B,house-skeptic=deepseek-ai/DeepSeek-V4.1-Flash-1017
SIGNER_KEYS_FILE=
AGENT_WEB_SEARCH=1
AGENT_DAILY_LOSS_USD=5
AGENT_KELLY_FRACTION=0.25
SIGNER_DAILY_SPEND_MICRO=10000000

# Jury runner. A function-call key limited to submit_verdict on the market is enough.
JURY_MODELS=deepseek-ai/DeepSeek-V4.1-Flash-1017,Qwen/Qwen3.8-27B,z-ai/glm-5.3-flash
JURY_ACCOUNT_ID=
# SECRET:
JURY_PRIVATE_KEY=
JURY_AUTO=1
JURY_TIMEOUT_MS=90000

# Keep at 1: a model without verified NVIDIA evidence is treated as unattested.
ATTESTATION_REQUIRE_GPU=1
