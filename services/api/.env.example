# Priced In API. Copy to services/api/.env (git-ignored) and fill in. `npm run api` reads it.
# Nothing here is secret except the three keys marked SECRET; never commit them.

# testnet (default) or mainnet. Mainnet is only ever used when this says mainnet.
NEAR_NETWORK=testnet
# Comma list; the first is preferred, the rest are failover and the async-broadcast race.
RPC_URLS=https://test.rpc.fastnear.com,https://rpc.testnet.near.org
# What the browser is told to broadcast to (defaults to RPC_URLS).
# PUBLIC_RPC_URLS=

PORT=8787
HOST=0.0.0.0
# Comma list of allowed origins, or * for any.
CORS_ORIGINS=*
# Set to 1 only behind a reverse proxy that appends X-Forwarded-For.
TRUST_PROXY=0

# The market contract, and its USDC token (to follow deposits into the market).
MARKET_CONTRACT_ID=market.example.testnet
USDC_CONTRACT_ID=tusdc.example.testnet

# The judges' lane: the pooled account that holds visitors' function-call keys.
LANE_ACCOUNT_ID=lane.example.testnet
# SECRET: a full-access key of LANE_ACCOUNT_ID, as ed25519:<base58>.
LANE_PRIVATE_KEY=
LANE_ALLOWANCE_NEAR=0.25
LANE_KEYS_PER_IP_PER_DAY=3
# A soft global cap per UTC day. The hard cap is the contract's lane_budget_micro, which
# the API mirrors: it refuses keys the contract could not credit.
LANE_KEYS_PER_DAY=1000

# The paste planner (NEAR AI Cloud, OpenAI-compatible). Without the API key /paste still
# splits the text and answers planner "unavailable": the page shows "pricing soon".
# SECRET:
NEARAI_API_KEY=
NEARAI_BASE_URL=https://cloud-api.near.ai/v1
PLANNER_MODEL=
# SECRET: the ed25519 key whose public half is set on the market with set_planner_key.
# ed25519:<base58>, or 32-byte seed / 64-byte secret key as hex. /health shows the public half.
PLANNER_PRIVATE_KEY=
# Liquidity b for markets opened from a paste, in micro-USDC ($1 = 1000000).
PLANNER_B_MICRO=1000000
PASTE_PER_IP_PER_DAY=60

# The post link (GET /post/:id, GET /post?url=): a public X post read through the public
# oEmbed endpoint, no key needed. New posts read per IP and in all per UTC day (views of
# posts already cached are free); cached posts are re-checked hourly so deletions are honoured.
POST_NEW_PER_IP_PER_DAY=40
POST_NEW_PER_DAY=3000
POST_RECHECK_MS=3600000
POST_OEMBED_TIMEOUT_MS=5000
POST_OEMBED_RETRIES=2
# POST_OEMBED_URL=https://publish.x.com/oembed
# POST_USER_AGENT=Mozilla/5.0 (compatible; PricedIn/1.0)
# Our own domains: a post link with x.com changed to one of these reads too.
POST_SELF_HOSTS=isitpriced.in,pricedin.app

# Health: fail when the last block scanned is older than this.
HEALTH_MAX_SCAN_AGE_S=30
# Optional: also fail when no market event arrived for this long (0 = report only).
HEALTH_MAX_EVENT_AGE_S=0

# Scanner tuning.
SCAN_INTERVAL_MS=400
SCAN_FINALITY=optimistic
# Blocks to replay at startup so the ring buffer isn't empty (0 = start at the head).
SCAN_BACKFILL_BLOCKS=0
EVENTS_RING_SIZE=200

# The truth API (GET /v1/credence). Free calls per address per UTC day; past them, x402.
CREDENCE_FREE_PER_IP_PER_DAY=20
# Signed rewrite records to serve as provenance, e.g. the judge deployment's evidence file.
# REWRITE_EVIDENCE_FILES=tools/judge/evidence/rewrite.json

# x402 v2 payments (NEAR "exact" scheme). Off unless X402_PAY_TO and a facilitator are set.
# Price per call in micro-USDC ($0.01 = 10000) of X402_ASSET (default: USDC_CONTRACT_ID on
# testnet; native USDC only when NEAR_NETWORK=mainnet).
# X402_PAY_TO=truth.example.testnet
X402_PRICE_MICRO=10000
# X402_ASSET=
X402_MAX_TIMEOUT_S=60
# Our own facilitator, in-process: a relayer account that pays the settlement gas.
# SECRET: a full-access key of X402_RELAYER_ACCOUNT_ID. With it, /x402/{supported,verify,settle}
# are also served (payments to X402_PAY_TO only); X402_FACILITATOR_ROUTES=0 hides them.
# X402_RELAYER_ACCOUNT_ID=
# X402_RELAYER_PRIVATE_KEY=
# Or a remote facilitator speaking the x402 HTTP interface:
# X402_FACILITATOR_URL=

# Only for services/api/test/lane-e2e.mjs (testnet): a funded testnet account that pays for
# the test's throwaway accounts and gets their balance back afterwards. SECRET.
# FUNDER_ID=
# FUNDER_KEY=
