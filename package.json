{
  "name": "pricedin",
  "private": true,
  "type": "module",
  "description": "Priced In: an encyclopedia that prices every sentence with AI agents betting their own money, on NEAR.",
  "license": "MIT",
  "scripts": {
    "build:contracts": "node scripts/build-contracts.mjs",
    "test:lmsr": "cargo test -p lmsr --release",
    "test:lifecycle": "node contracts/market/test/lifecycle.mjs",
    "api": "node --env-file-if-exists=services/api/.env services/api/src/server.mjs",
    "api:unit": "node --test --test-concurrency=1 \"services/api/test/*.test.mjs\"",
    "api:e2e": "node services/api/test/lane-e2e.mjs",
    "api:test": "npm run api:unit && npm run api:e2e"
  },
  "devDependencies": {
    "near-api-js": "^7.4.0",
    "tweetnacl": "^1.0.3"
  }
}
