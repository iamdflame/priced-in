{
  "name": "pricedin",
  "private": true,
  "type": "module",
  "description": "Priced In: an encyclopedia that prices every sentence with AI agents betting their own money, on NEAR.",
  "license": "MIT",
  "scripts": {
    "build:contracts": "node scripts/build-contracts.mjs",
    "deploy": "node scripts/deploy.mjs",
    "test:rules": "cargo test -p rules --release",
    "test:lmsr": "cargo test -p lmsr --release",
    "test:lifecycle": "node contracts/market/test/lifecycle.mjs",
    "api": "node --env-file-if-exists=services/api/.env services/api/src/server.mjs",
    "api:unit": "node --test --test-concurrency=1 \"services/api/test/*.test.mjs\"",
    "api:e2e": "node services/api/test/lane-e2e.mjs",
    "api:post-smoke": "node services/api/test/post-smoke.mjs",
    "api:test": "npm run api:unit && npm run api:e2e",
    "ai": "node --env-file-if-exists=services/api/.env --env-file-if-exists=services/ai/.env services/ai/src/server.js",
    "ai:attest": "node --env-file-if-exists=services/api/.env --env-file-if-exists=services/ai/.env services/ai/src/jury.js --attest",
    "ai:unit": "node --test --test-concurrency=1 \"services/ai/test/*.test.mjs\"",
    "ai:e2e": "node services/ai/test/jury-e2e.mjs",
    "ai:crowd-e2e": "node services/ai/test/crowd-e2e.mjs",
    "ai:house": "node --env-file-if-exists=services/ai/.env services/ai/scripts/house-agents.mjs",
    "pnl": "node --env-file-if-exists=services/api/.env --env-file-if-exists=services/ai/.env services/ai/scripts/pnl.mjs",
    "ai:smoke": "node --env-file-if-exists=services/ai/.env services/ai/test/live-smoke.mjs",
    "ai:test": "npm run ai:unit && npm run ai:e2e && npm run ai:smoke",
    "corpus:check": "node corpus/scripts/check.mjs",
    "web:install": "npm --prefix web ci",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:test": "npm --prefix web test",
    "web:e2e": "npm --prefix web run e2e"
  },
  "devDependencies": {
    "@phala/dcap-qvl": "0.7.1",
    "near-api-js": "^7.4.0",
    "tweetnacl": "^1.0.3"
  }
}
